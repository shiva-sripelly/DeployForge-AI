# Docker Compose configuration. Copy to .env (git-ignored) before `docker compose up`.
# Every value here is a local-development placeholder, not a real secret.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

POSTGRES_USER=deployforge
POSTGRES_PASSWORD=deployforge_dev_password
POSTGRES_DB=deployforge

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start in production with a placeholder or short key.
JWT_SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only sign-in (Phase 2 replaces this with SSO). Must be false in production.
DEV_AUTH_ENABLED=true
# Create demo accounts and a sample organization on startup (idempotent).
SEED_DEV_DATA=true

CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Host ports (all bound to 127.0.0.1).
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433

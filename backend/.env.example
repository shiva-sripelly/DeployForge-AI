# Backend configuration for running the API directly on your machine
# (outside Docker). Copy to backend/.env and adjust. Never commit .env files.

ENVIRONMENT=development
LOG_LEVEL=INFO
# json (structured, default) or console (human-readable)
LOG_FORMAT=console

# Points at the Docker Compose PostgreSQL service published on 127.0.0.1:5433 (IPv4; "localhost" may try IPv6 first and stall).
DATABASE_URL=postgresql+psycopg://deployforge:deployforge_dev_password@127.0.0.1:5433/deployforge

# Hosted PostgreSQL options (see docs/deployment/CLOUD_DEPLOYMENT.md). Production
# requires DATABASE_SSL_MODE (or sslmode in DATABASE_URL) of require/verify-ca/verify-full.
# DATABASE_SSL_MODE=require
# DATABASE_SSL_ROOT_CERT=/path/to/ca.crt
# DATABASE_DISABLE_PREPARED_STATEMENTS=false   # true for transaction-mode poolers
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_RECYCLE_SECONDS=1800
# DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Generate a unique value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only token endpoint (POST /api/v1/auth/dev/token).
# The API refuses to start with this enabled when ENVIRONMENT=production.
DEV_AUTH_ENABLED=true

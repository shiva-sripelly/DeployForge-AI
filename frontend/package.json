    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "axios": "^1.20.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",

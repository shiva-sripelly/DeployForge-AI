# Frontend build-time configuration (Vite). Copy to frontend/.env.local if needed.
# Values prefixed with VITE_ are embedded in the browser bundle: never put secrets here.

# Base path of the API as seen by the browser. The default "/api/v1" works with
# both the Vite dev proxy and the nginx proxy in Docker. For the public demo on
# Vercel, set it to the absolute backend URL, e.g.
#   https://<render-service>.onrender.com/api/v1
# Production builds refuse localhost and non-https values.
VITE_API_BASE_URL=/api/v1

# "full" (default): console with development sign-in. "demo": public read-only
# demo with synthetic data. `npm run build:demo` sets demo via .env.demo.
# VITE_APP_MODE=full

# Where the Vite dev server forwards /api requests (dev server only, never bundled).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
